# Copy to .env for local dev (.env is git-ignored). Run:
#   uvicorn app.main:app --env-file .env

# --- Persistence ---
# Omit for local SQLite; set to a Postgres URL in production.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Auth / security ---
# Strong random secret used to sign JWTs. REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Set to 1 in production (HTTPS) so the session cookie is Secure-only.
COOKIE_SECURE=0

# --- LLM folder chat (optional) ---
# Without these, folder chat is cleanly disabled (returns a clear message).
# OpenRouter is OpenAI-compatible. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
